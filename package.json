{
  "name": "finmarket_house",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && (concurrently -n \"Next,Vitest\" -c white,green -k -s command-vitest \"next dev\" \"vitest --watch=false --no-file-parallelism\"; npm run services:stop)",
    "test:watch": "vitest --no-file-parallelism",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "npx eslint .",
    "lint:eslint:fix": "npx eslint . --fix",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up",
    "services:wait:database": "node ./infra/scripts/waitDatabase.js",
    "upgrade": "npx npm-check-updates -i",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "cookie": "2.0.1",
    "dotenv": "18.0.0",
    "next": "16.3.5",
    "next-connect": "1.0.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "2.5.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@faker-js/faker": "10.6.0",
    "@types/pg": "8.23.1",
    "commitizen": "4.3.2",
    "concurrently": "10.0.5",
    "dotenv-expand": "1000.0.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "husky": "9.1.7",
    "prettier": "3.9.8",
    "set-cookie-parser": "3.1.2",
    "vitest": "^5.0.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
